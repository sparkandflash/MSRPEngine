# ==========================================
# VRON-V1 ENGINE CONFIGURATION
# ==========================================

# 1. API Credentials
VRON_LLM_PROVIDER="openai" # e.g. openai, anthropic, ollama
VRON_LLM_API_KEY="your_llm_api_key_here"
VRON_LLM_MODEL="gpt-4o"

EMBEDDING_PROVIDER="openai"
EMBEDDING_API_KEY="your_embedding_api_key_here"
EMBEDDING_MODEL="text-embedding-3-small"

# 2. Engine Thermodynamics & Rate Limits
# The base tick rate at which the InstanceManager pops the queue (in milliseconds)
BASE_TICK_RATE_MS=4000

# The maximum size of the Global Energy pool
MAX_GLOBAL_ENERGY=100

# 3. Sleep Modes & Hibernation
# Mode 2: If the user hasn't sent a message in this many minutes, stop proactive VRon messages.
USER_IDLE_TIMEOUT_MINUTES=5

# Mode 3: If the engine AND user have been idle for this many minutes, enter deep hibernation.
ENGINE_HIBERNATION_TIMEOUT_MINUTES=15
